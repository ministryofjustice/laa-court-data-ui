- content_for :pre_heading do
  = render "/feedback_on_appeals_to_crown_court", application: @application

= govuk_page_heading(accessible_text(@application.application_reference),
                     caption_text: t("subjects.#{@application.application_category}"),
                     title: "#{t("subjects.#{@application.application_category}")} #{@application.application_reference}",
                     tag_options: { class: "govuk-!-margin-bottom-4" })

- if @application.appeal?
  .govuk-body
    %strong
      = t(".type_of_appeal")
    = @application.application_title
  .govuk-body
    %strong
      = t(".result")
    = @application.result_string
  %h2.govuk-heading-l
    = t(".appellant")
  .govuk-body
    = t("court_applications.show.appeal_alert")
- else
  .govuk-body
    %strong
      = t(".type_of_application")
    = @application.application_title
  .govuk-body
    %strong
      = t(".result")
    = @application.result_string
  %h2.govuk-heading-l
    = t(".respondent")
  .govuk-body
    = t("court_applications.show.alert")
%table.govuk-table
  %caption.govuk-table__caption.govuk-visually-hidden
    = t(".respondent")
  %thead.govuk-table__head
    %tr.govuk-table__row
      %th.govuk-table__header{ scope: "col" }= t(".defendant.name")
      %th.govuk-table__header{ scope: "col" }= t(".defendant.date_of_birth")
      %th.govuk-table__header{ scope: "col" }= accessible_text(t(".defendant.maat_number"))
      - if @application.breach?
        %th.govuk-table__header{ scope: "col" }= t(".defendant.breach_date")
  %tbody.govuk-table__body
    %tr.govuk-table__row
      %td.govuk-table__cell
        = link_to @application.subject_summary.name, court_application_subject_path(@application.application_id), class: "govuk-link"
      %td.govuk-table__cell
        = accessible_date(@application.subject_summary.date_of_birth)
      %td.govuk-table__cell
        = accessible_text(@application.maat_reference) || t("search.result.defendant.unlinked")
      - if @application.breach?
        %td.govuk-table__cell
          = accessible_date(@application.received_date&.to_date)

= render "hearings", hearing_days: @application.hearing_days_sorted_by(@date_sort_direction), date_sort_direction: @date_sort_direction, application: @application
