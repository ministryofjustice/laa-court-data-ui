:ruby
  not_available = t("generic.not_available")
  respondent_synonyms = t("hearings.show.court_applications.respondent_synonyms")
  applicant_synonym = t("hearings.show.court_applications.applicant_synonym")

%h2.govuk-heading-l{ class: "govuk-!-margin-bottom-4" }
  = t("hearings.show.court_applications.heading")
- if hearing && hearing.court_applications.present?
  - hearing.court_applications.each do |court_application|
    .govuk-summary-card
      .govuk-summary-card__title-wrapper
        %h3.govuk-summary-card__title
          = court_application&.type&.description || not_available
      .govuk-summary-card__content
        %table.govuk-table.vcd-court-applications-table{ class: "govuk-!-margin-bottom-4" }
          %caption.govuk-table__caption.govuk-visually-hidden
            = court_application&.type&.description || not_available
          %tbody.govuk-table__body
            %tr.govuk-table__row
              %th.govuk-table__header{ scope: "row" }
                = t("hearings.show.court_applications.received_date")
              %td.govuk-table__cell
                = accessible_date(court_application.received_date&.to_date, id: "court-application-received-date", format: :long)
            %tr.govuk-table__row
              %th.govuk-table__header{ scope: "row" }
                = t("hearings.show.court_applications.code")
              %td.govuk-table__cell
                = court_application&.type&.code || not_available
            %tr.govuk-table__row
              %th.govuk-table__header{ scope: "row" }
                = t("hearings.show.court_applications.legislation")
              %td.govuk-table__cell
                = court_application&.type&.legislation || not_available
            - court_application.judicial_results&.each do |result|
              %tr.govuk-table__row
                %th.govuk-table__header{ scope: "row" }
                  = t("hearings.show.court_applications.result_codes")
                %td.govuk-table__cell
                  = result&.cjs_code || not_available
              %tr.govuk-table__row
                %th.govuk-table__header{ scope: "row" }
                  = t("hearings.show.court_applications.result_text")
                %td.govuk-table__cell
                  - if result&.text.present?
                    = transform_and_sanitize(result&.text)
                  - else
                    = not_available
            %tr.govuk-table__row
              %th.govuk-table__header{ scope: "row" }
                = respondent_synonyms
              %td.govuk-table__cell
                = safe_join(court_application.respondents.map(&:synonym), tag.br).presence || not_available
            %tr.govuk-table__row
              %th.govuk-table__header{ scope: "row" }
                = applicant_synonym
              %td.govuk-table__cell
                = court_application.type.applicant_appellant_flag ? "Applicant" : not_available
- else
  %p.govuk-body
    = t("hearings.show.court_applications.none")
