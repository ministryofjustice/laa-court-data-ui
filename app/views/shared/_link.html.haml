-# locals: (url:, form_model:, hint: nil, show_heading: true, inset_text: nil, secondary_link: nil)

- if show_heading
  %h2.govuk-heading-m{ class: "govuk-!-margin-bottom-4" }
    = t("generic.link_court_data")
= form_with(model: form_model, url: url, data: { turbo_stream: true }) do |f|
  - content_for :error_summary do
    = f.govuk_error_summary

  - field_options = { label: { text: sanitize_html(t("laa_reference.link.form.maat_reference.label", maat_id: t("acronyms.maat_id_html"))) }, width: "two-thirds" }
  - field_options[:hint] = { text: hint } if local_assigns[:hint]
  = f.govuk_text_field :maat_reference, **field_options

  - if local_assigns[:inset_text]
    .govuk-inset-text= inset_text

  .govuk-button-group
    = f.govuk_submit t("laa_reference.link.form.submit"), data: { disable_with: "Linking..." }, name: "maat_ref_required", value: "true"
    - if local_assigns[:secondary_link]
      = link_to secondary_link.fetch(:text), secondary_link.fetch(:url), class: "govuk-link"

  = govuk_detail(sanitize_html(t("laa_reference.missing_maat_id.label", maat_id: t("acronyms.maat_id_html")))) do
    %p.govuk-details__details-text= t("laa_reference.missing_maat_id.description")
    = f.govuk_submit(sanitize_html(t("laa_reference.missing_maat_id.submit", maat_id: t("acronyms.maat_id_html"))),
                     secondary: true, name: "maat_ref_required", value: "false")
