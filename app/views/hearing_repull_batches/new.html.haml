= govuk_page_heading(t(".title"))

= form_with model: @batch, url: hearing_repull_batches_path do |f|
  .govuk-grid-row
    .govuk-grid-column-full
      = f.govuk_error_summary
      = f.govuk_text_area :maat_ids,
                          label: { text: sanitize_html(t(".label", maat_ids: t("acronyms.maat_ids_html"))) },
                          hint: { text: sanitize_html(t(".hint", maat_ids: t("acronyms.maat_ids_html"))) },
                          rows: 5,
                          max_chars: 500

  .govuk-grid-row
    .govuk-grid-column-full
      = f.govuk_submit(t(".submit"))
