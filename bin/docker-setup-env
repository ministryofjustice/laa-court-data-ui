#!/usr/bin/env sh

set -eu

if [ ! -d ../laa-court-data-adaptor ]; then
  printf '%s\n' "Expected ../laa-court-data-adaptor to exist next to this repo." >&2
  exit 1
fi

ENV_TARGET=mock
for arg in "$@"; do
  case "$arg" in
    --target=mock)
      ENV_TARGET=mock
      ;;
    --target=sit)
      ENV_TARGET=sit
      ;;
    *)
      echo "Usage: $0 [--target=mock|--target=sit]" >&2
      exit 2
      ;;
  esac
done

uid=$(docker compose run --rm cda bundle exec rails runner 'print Doorkeeper::Application.first_or_create(name: "My CDA Client").uid' | tail -n1)
secret=$(docker compose run --rm cda bundle exec rails runner 'print Doorkeeper::Application.first_or_create(name: "My CDA Client").secret' | tail -n1)

{
  printf '%s\n' 'GA_TRACKING_ID: UA-XXXXXXXXX-XX'
  printf '%s\n' 'DISPLAY_RAW_RESPONSES: enabled'
  printf '%s\n' 'COURT_DATA_ADAPTOR_API_URL: http://localhost:3001/api/internal/v1'
  printf '%s\n' "COURT_DATA_ADAPTOR_API_UID: ${uid}"
  printf '%s\n' "COURT_DATA_ADAPTOR_API_SECRET: ${secret}"
  printf '%s\n' 'FAKE_AUTH: true'
} > .env.development


if [ "$ENV_TARGET" = sit ]; then
  ../laa-court-data-adaptor/script/generate_env --target=sit
else
  ../laa-court-data-adaptor/script/generate_env --target=mock
fi

